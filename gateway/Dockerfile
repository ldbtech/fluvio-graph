FROM debian:bookworm-slim

# Apollo Router binary — multi-arch (works on amd64 and Apple Silicon arm64).
ARG ROUTER_VERSION=1.49.1
ARG TARGETARCH
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
  && rm -rf /var/lib/apt/lists/* \
  && case "$TARGETARCH" in \
       amd64) RARCH=x86_64-unknown-linux-gnu ;; \
       arm64) RARCH=aarch64-unknown-linux-gnu ;; \
       *) echo "unsupported TARGETARCH=$TARGETARCH" && exit 1 ;; \
     esac \
  && curl -fL --retry 8 --retry-delay 3 --retry-all-errors --connect-timeout 30 --max-time 600 \
       "https://github.com/apollographql/router/releases/download/v${ROUTER_VERSION}/router-v${ROUTER_VERSION}-${RARCH}.tar.gz" -o /tmp/router.tgz \
  && tar -xzf /tmp/router.tgz -C /tmp \
  && mv "$(find /tmp -type f -name router | head -1)" /usr/local/bin/router \
  && chmod +x /usr/local/bin/router \
  && rm -rf /tmp/router.tgz /tmp/dist

WORKDIR /gateway
COPY router.yaml ./
# supergraph.docker.graphql, NOT supergraph.graphql: the latter is
# regenerated by scripts/dev.sh (from supergraph.yaml, using 127.0.0.1 URLs)
# for the local, non-Docker dev workflow — sharing a filename between the two
# would mean whichever ran most recently silently clobbers the other's
# routing URLs. This one is composed from supergraph.docker.yaml, whose
# routing_url values are the docker-compose service hostnames. Regenerate it
# whenever a subgraph's GraphQL schema changes:
#   cd gateway && APOLLO_ELV2_LICENSE=accept rover supergraph compose \
#     --config supergraph.docker.yaml --output supergraph.docker.graphql
# (run against subgraphs reachable at the 127.0.0.1 ports docker-compose.yml
# host-publishes — e.g. via `docker compose up` itself).
COPY supergraph.docker.graphql ./

EXPOSE 4001

HEALTHCHECK --interval=5s --timeout=3s --retries=10 \
  CMD curl -sf http://localhost:4001/health || exit 1

ENTRYPOINT ["router", "--config", "router.yaml", "--supergraph", "supergraph.docker.graphql"]

# ── Generate RSA key pair (run once) ─────────────────────────────────────────
# node src/keygen.js
# Then paste the output below:

FLUVIOME_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
FLUVIOME_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Map your Stripe Price IDs to tiers:
STRIPE_PRICE_STARTER=price_...
STRIPE_PRICE_GROWTH=price_...
STRIPE_PRICE_ENTERPRISE=price_...

# ── SMTP (SendGrid / Postmark / SES) ─────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG....
MAIL_FROM=fluvioMe <hello@fluviome.com>
TEAM_EMAIL=team@fluviome.com

# ── Service ───────────────────────────────────────────────────────────────────
TOKEN_SERVICE_PORT=4003
SERVICE_SECRET=change-this-to-a-random-secret   # protects GET /token/:orgId
CORS_ORIGIN=https://fluviome.com

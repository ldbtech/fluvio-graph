/target
.fastembed_cache/
planet.txt
speech.txt
.env
.env.local
.env.*.local

# Legacy in-process graph snapshots — replaced by SurrealDB. Ignored so a stray
# write or copy from older builds never ends up in git again.
fluvio_graphs/
web/fluvio-ui/fluvio_graphs/

# SurrealDB embedded data dirs.
fluvio_surreal.db/
fluvio_surreal_data/
fluvio_surreal_collab_data/

# macOS finder metadata.
.DS_Store

# Runtime logs / pids and throwaway scratch scripts (never commit).
.logs/
.logs-stack/
.pids/
scratch/

# Nested example crates build their own target/
examples/*/target/
examples/*/Cargo.lock

# Python bytecode + virtualenvs (regenerable — never commit)
__pycache__/
*.pyc
.venv/
venv/

# Python packaging build metadata (regenerated by editable/wheel installs)
*.egg-info/
build/
dist/
